NODE_ENV=development

# Non-production: seller product create can INSERT placeholder store/category rows when missing. Set false to disable.
# DEV_BOOTSTRAP_STORE=false
# User id for placeholder store row (must exist in `users` when bootstrap runs). Defaults to 1.
# DEV_BOOTSTRAP_SELLER_USER_ID=1

SERVER_PORT=5000
SERVER_URL=http://localhost:5000

DATABASE_URL="mysql://root:password@localhost:3306/db_name"
SHADOW_DATABASE_URL="mysql://root:@localhost:3306/db_name"

CLIENT_1=http://localhost:5173

ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

SMS_GATEWAY_URL=
SMS_GATEWAY_SEND_URL=
SMS_GATEWAY_USERID=
SMS_GATEWAY_PASSWORD=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

MAIL_SERVICE=
MAIL_HOST=
MAIL_PORT=
MAIL_PORT_SECURE=
MAIL_USER=
MAIL_PASSWORD=

META_APP_NAME=
META_APP_URL=
