generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id                 Int      @id @default(autoincrement())
    username           String   @unique @default(cuid())
    name               String
    email              String?
    phoneNumber        String   @unique
    password           String?
    avatar             String?
    role               UserRole @default(USER)
    isTwoFactorEnabled Boolean  @default(false)

    createdAt DateTime? @default(now())
    updatedAt DateTime  @updatedAt

    accounts Account[]
    profile  Profile?
}

enum UserRole {
    ADMIN
    USER
    SELLER
}

model Account {
    id                    String          @id @default(cuid())
    userId                Int
    type                  AccountType
    provider              AccountProvider
    providerAccountId     String
    refreshToken          String?         @db.Text
    accessToken           String?         @db.Text
    expiresAt             Int?
    tokenType             String?
    scope                 String?
    idToken               String?         @db.Text
    sessionState          String?
    status                AccountStatus   @default(ACTIVE)
    phoneNumberVerifiedAt DateTime?
    emailVerifiedAt       DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

enum AccountType {
    CREDENTIALS
    GOOGLE
    GITHUB
}

enum AccountProvider {
    CREDENTIALS
    GOOGLE
    GITHUB
}

enum AccountStatus {
    ACTIVE
    INACTIVE
    PENDING
    BLOCKED
}

model Otp {
    id          Int       @id @default(autoincrement())
    phoneNumber String
    code        String
    createdAt   DateTime  @default(now())
    expiresAt   DateTime
    usedAt      DateTime?

    authToken    String?
    authTokenRef AuthToken? @relation(fields: [authToken], references: [token], onDelete: Cascade)
}

model AuthToken {
    token       String        @id @default(uuid())
    phoneNumber String
    createdAt   DateTime      @default(now())
    expiresAt   DateTime
    type        AuthTokenType
    usedAt      DateTime?

    otp Otp[]

    @@unique([phoneNumber, token])
}

enum AuthTokenType {
    RESET_PASSWORD
    VERIFICATION
    FORGOT_PASSWORD
}

model Profile {
    id        Int      @id @default(autoincrement())
    userId    Int      @unique
    about     String?
    region    String?
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model cmsSlider {
    id            BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
    pageId        BigInt? @db.UnsignedBigInt
    imageUploadId BigInt? @db.UnsignedBigInt
    imageUrl      String? @db.VarChar(800)

    image       String?
    imageMobile String?

    heading        String  @db.VarChar(200)
    subheading     String? @db.VarChar(240)
    buttonText     String? @db.VarChar(60)
    buttonRedirect String? @map("button_redirect") @db.VarChar(500)

    sortOrder Int     @default(0)
    isActive  Boolean @default(true)

    createdBy BigInt?   @db.UnsignedBigInt
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt
    deletedAt DateTime?
}

// ─── Media Feature ───────────────────────────────────────────────────────────

enum FileType {
    IMAGE
    PDF
    DOC
    OTHER
}

enum StorageProvider {
    LOCAL
    S3
    CDN
}

model MediaFile {
    id              String          @id @default(uuid())
    fileType        FileType        @map("file_type")
    originalName    String          @map("original_name")
    mimeType        String          @map("mime_type")
    fileSizeBytes   Int             @map("file_size_bytes")
    storageProvider StorageProvider @default(LOCAL) @map("storage_provider")
    storagePath     String          @map("storage_path")
    publicUrl       String          @map("public_url")
    checksumSha256  String          @map("checksum_sha256")
    uploadedBy      Int?            @map("uploaded_by")
    createdAt       DateTime        @default(now()) @map("created_at")
    deletedAt       DateTime?       @map("deleted_at")

    @@map("media_files")
}

// ─── Announcement Feature ───
model Announcement {
    id           Int       @id @default(autoincrement())
    text         String
    contactPhone String?
    contactEmail String?
    isPublished  Boolean   @default(false)
    startAt      DateTime?
    endAt        DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    deletedAt    DateTime?

    @@index([isPublished])
    @@index([startAt, endAt])
}



// ─── Testimonials Feature ───
model Testimonial {
    id               Int      @id @default(autoincrement())
    customerName     String   @db.VarChar(100)
    location         String?  @db.VarChar(100)
    testimonialText  String   @db.Text
    rating           Int      @default(5)
    customerPhoto    String?  @db.VarChar(255)
    productOrService String?  @db.VarChar(100)
    isPublished      Boolean  @default(false)
    
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    deletedAt        DateTime?

    @@index([isPublished])
}

// ─── Contact Message Feature ───
model ContactMessage {
    id          Int                   @id @default(autoincrement())
    fullName    String
    email       String
    orderNumber String?
    topic       ContactMessage_topic
    message     String
    status      ContactMessage_status @default(UNRESOLVED)
    adminNotes  String?
    resolvedBy  Int?
    resolvedAt  DateTime?
    createdAt   DateTime              @default(now())
    updatedAt   DateTime              @updatedAt
}

enum ContactMessage_topic {
    GENERAL_INQUIRY
    ORDER_STATUS
    RETURNS
}

enum ContactMessage_status {
    RESOLVED
    UNRESOLVED
}

