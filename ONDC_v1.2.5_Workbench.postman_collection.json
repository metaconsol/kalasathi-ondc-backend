{
  "info": {
    "name": "ONDC ODOP BPP — v1.2.5 Workbench",
    "description": "Full endpoint collection for the ODOP ONDC BPP, aligned to API contract v1.2.5. Use with the 'ONDC ODOP — v1.2.5 (preprod)' environment. Folder 1 = network-facing Beckn endpoints (the workbench/Pramaan calls these). Folder 2 = JWT-protected admin APIs. See implementationplan.md for endpoint status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Beckn Protocol — BAP→BPP (network-facing)",
      "description": "These are the endpoints the ONDC workbench / Pramaan (acting as BAP) POSTs to. In production every request must carry a valid ONDC `Authorization` signature header. For LOCAL testing without signing, point ONDC_BASE at {{LOCAL_BASE}} and append {{INSECURE}} to the path (e.g. /search?insecure=1) — works only when NODE_ENV != production. Each endpoint ACKs synchronously, then POSTs the on_<action> callback to {{BAP_URI}}/<action>.",
      "item": [
        {
          "name": "POST /search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"{{DOMAIN}}\",\n    \"action\": \"search\",\n    \"country\": \"IND\",\n    \"city\": \"{{CITY}}\",\n    \"core_version\": \"{{CORE_VERSION}}\",\n    \"bap_id\": \"{{BAP_ID}}\",\n    \"bap_uri\": \"{{BAP_URI}}\",\n    \"transaction_id\": \"{{TXN_ID}}\",\n    \"message_id\": \"{{MSG_ID}}\",\n    \"timestamp\": \"{{$isoTimestamp}}\",\n    \"ttl\": \"PT30S\"\n  },\n  \"message\": {\n    \"intent\": {\n      \"item\": {\n        \"descriptor\": {\n          \"name\": \"kurta\"\n        }\n      },\n      \"fulfillment\": {\n        \"type\": \"Delivery\",\n        \"end\": {\n          \"location\": {\n            \"gps\": \"12.9715987,77.5945627\",\n            \"address\": {\n              \"area_code\": \"560001\"\n            }\n          }\n        }\n      },\n      \"payment\": {\n        \"@ondc/org/buyer_app_finder_fee_type\": \"percent\",\n        \"@ondc/org/buyer_app_finder_fee_amount\": \"3\"\n      },\n      \"tags\": [\n        {\n          \"code\": \"bap_terms\",\n          \"list\": [\n            {\n              \"code\": \"static_terms\",\n              \"value\": \"https://buyerapp.com/legal\"\n            },\n            {\n              \"code\": \"static_terms_new\",\n              \"value\": \"https://buyerapp.com/legal-2024\"\n            },\n            {\n              \"code\": \"effective_date\",\n              \"value\": \"2024-01-01T00:00:00.000Z\"\n            }\n          ]\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ONDC_BASE}}/search?insecure=1",
              "host": ["{{ONDC_BASE}}"],
              "path": ["search"],
              "query": [
                {
                  "key": "insecure",
                  "value": "1",
                  "description": "Localhost signature bypass. Disable/delete this param when testing signed."
                }
              ]
            },
            "description": "Buyer search intent → on_search catalog."
          },
          "response": []
        },
